{
  "name": "hali-saha-mac-videosu",
  "version": "1.0.0",
  "description": "Remotion ile hazırlanmış halı saha maçı duyuru videosu",
  "scripts": {
    "music": "node scripts/make-music.mjs && remotion ffmpeg -y -loglevel error -i public/music.wav -codec:a libmp3lame -b:a 192k public/music.mp3 && rm -f public/music.wav",
    "studio": "remotion studio",
    "build": "remotion render MatchVideo out/hali-saha-mac.mp4",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axemixer/hello-world.git"
  },
  "keywords": [],
