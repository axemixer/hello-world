  "bugs": {
    "url": "https://github.com/axemixer/hello-world/issues"
  },
  "homepage": "https://github.com/axemixer/hello-world#readme",
  "dependencies": {
    "@remotion/cli": "^4.0.526",
    "@remotion/google-fonts": "^4.0.526",
    "@remotion/player": "^4.0.526",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.526"
  },
  "devDependencies": {
    "@remotion/eslint-config": "^4.0.526",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
